+
+	undeclared, _, err := buildOneAgent(cfg, "zoe", payloads, ReviewRange{Base: "a", Head: "b"}, "", "")
+	require.NoError(t, err)
+	assert.Empty(t, undeclared.Invocation.ResponseFormat, "an undeclared agent sends no response_format")
+}
