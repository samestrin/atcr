+		return &llmclient.ChatResponse{Message: llmclient.Message{Role: "assistant", ToolCalls: []llmclient.ToolCall{{
+			ID: "c1", Type: "function", Function: llmclient.FunctionCall{Name: tools[0].Name, Arguments: []byte("{}")},
