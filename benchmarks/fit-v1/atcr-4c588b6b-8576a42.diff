+// AC 04-04: a host-review-shaped .txt-only source keeps reconciling beside a
+// dual-written pool, each resolved on its own.
+func TestDiscover_TxtOnlyHostBesideDualWrittenPool(t *testing.T) {
+	dir := t.TempDir()
