+	}
+	for _, tt := range tests {
+		tt := tt
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			v, err := parseVerdict(tt.response)
+			require.NoError(t, err)
+			require.NotNil(t, v)
+			assert.Equal(t, verdictRefuted, v.Verdict)
+			assert.Equal(t, tt.notes, v.Notes)
+		})
+	}
+}
