+
+	sources, err := Discover(dir, nil)
+	require.NoError(t, err)
+	pool, ok := sourceByName(sources, "pool")
+	require.True(t, ok)
+	assert.Equal(t, []stream.Finding{lossless}, pool.Findings)
+}
+
+func TestDiscover_ToonOnlyLeaf(t *testing.T) {
