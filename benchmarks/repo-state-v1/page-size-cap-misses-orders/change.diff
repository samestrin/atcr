@@ -1,3 +1,7 @@
 """Paging defaults shared by the list endpoints."""
 
 DEFAULT_PAGE_SIZE = 50
+
+# The most rows one list request may read. A client asking for more gets this
+# many; a client asking for fewer than one gets one.
+MAX_PAGE_SIZE = 200
diff --git a/api/users.py b/api/users.py
index e7d5e3f..8c7ce2c 100644
--- a/api/users.py
+++ b/api/users.py
@@ -1,8 +1,12 @@
 """GET /users."""
-from api.paging import DEFAULT_PAGE_SIZE
+from api.paging import DEFAULT_PAGE_SIZE, MAX_PAGE_SIZE
 
 
 def list_users(db, query):
-    """Return one page of users; the page size is the client's ?limit=."""
+    """Return one page of users.
+
+    The page size is the client's ?limit=, clamped to 1..MAX_PAGE_SIZE.
+    """
     limit = int(query.get("limit", DEFAULT_PAGE_SIZE))
+    limit = max(1, min(limit, MAX_PAGE_SIZE))
     return db.fetch("SELECT id, email FROM users ORDER BY id LIMIT ?", limit)
